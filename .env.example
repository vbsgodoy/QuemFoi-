# Firebase Console > Configurações do projeto > Contas de serviço > Gerar nova chave privada.
# Copie os campos do JSON baixado:
FIREBASE_PROJECT_ID=seu-projeto
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@seu-projeto.iam.gserviceaccount.com
# Cole a chave entre aspas, com os \n (é secreta: nunca use NEXT_PUBLIC_ nela)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Endereço público do site, usado para montar os links enviados
NEXT_PUBLIC_SITE_URL=http://localhost:3000
